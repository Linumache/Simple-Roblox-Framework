imple-Roblox-Framework/docs/intro#introduction","content":" Simple-Roblox-Framework is a simple and flexible framework template for Roblox games and projects that provides essential lifecycle management and miscellaneous utilities, built on and designed to work with NevermoreEngine. ","version":"Next","tagName":"h2"},{"title":"ValueStore","type":0,"sectionRef":"#","url":"/Simple-Roblox-Framework/api/ValueStore","content":"","keywords":"","version":null},{"title":"Types​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#types","content":" ","version":null,"tagName":"h2"},{"title":"StoreEntry​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#StoreEntry","content":"&lt;/&gt; interface StoreEntry { Scope: ValueScope Value: any }  ","version":null,"tagName":"h3"},{"title":"Functions​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#functions","content":" ","version":null,"tagName":"h2"},{"title":"new​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#new","content":"&lt;/&gt; ValueStore.new() → ValueStore   ","version":null,"tagName":"h3"},{"title":"Add​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#Add","content":"&lt;/&gt; ValueStore:Add( Scope: ValueScope, Name: string, Value: any? ) → () Create an entry for a value if it doesn't exist.  ","version":null,"tagName":"h3"},{"title":"Set​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#Set","content":"&lt;/&gt; ValueStore:Set( Name: string, Value: any ) → () Set an entry's value, or create one if it doesn't exist.  ","version":null,"tagName":"h3"},{"title":"Has​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#Has","content":"&lt;/&gt; ValueStore:Has(Name: string) → boolean   ","version":null,"tagName":"h3"},{"title":"Get​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#Get","content":"&lt;/&gt; ValueStore:Get(Name: string) → any   ","version":null,"tagName":"h3"},{"title":"Remove​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#Remove","content":"&lt;/&gt; ValueStore:Remove(Name: string) → ()   ","version":null,"tagName":"h3"},{"title":"RemoveScope​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#RemoveScope","content":"&lt;/&gt; ValueStore:RemoveScope(Scope: ValueScope) → ()   ","version":null,"tagName":"h3"},{"title":"GetObservable​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#GetObservable","content":"&lt;/&gt; ValueStore:GetObservable(Name: string) → Observable &lt;any?&gt;   ","version":null,"tagName":"h3"},{"title":"GetGlobalObservable​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#GetGlobalObservable","content":"&lt;/&gt; ValueStore:GetGlobalObservable() → Observable &lt;{[string]: any}&gt;  WARNING The global state table is shared and is not cloned. By using the observable, you should've known what you're doing.  ","version":null,"tagName":"h3"},{"title":"GetGlobalEntries​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#GetGlobalEntries","content":"&lt;/&gt; ValueStore:GetGlobalEntries() → {[string]: any}  WARNING The global state table is shared and is not cloned. By using the returned table, you should've known what you're doing.  ","version":null,"tagName":"h3"},{"title":"Observe​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#Observe","content":"&lt;/&gt; ValueStore:Observe( Name: string, Callback: (Value: any?) → () ) → Subscription &lt;any?&gt;   ","version":null,"tagName":"h3"},{"title":"ObserveGlobal​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#ObserveGlobal","content":"&lt;/&gt; ValueStore:ObserveGlobal(Callback: (Entries: {[string]: any}) → ()) → Subscription &lt;{[string]: any}&gt;  WARNING The global state table is shared and is not cloned. By using the observable, you should've known what you're doing.  ","version":null,"tagName":"h3"},{"title":"Destroy​","type":1,"pageTitle":"ValueStore","url":"/Simple-Roblox-Framework/api/ValueStore#Destroy","content":"&lt;/&gt; ValueStore:Destroy() → ()  ","version":null,"tagName":"h3"},{"title":"setup","type":0,"sectionRef":"#","url":"/Simple-Roblox-Framework/docs/setup","content":"","keywords":"","version":"Next"},{"title":"Create a Project Using This Template​","type":1,"pageTitle":"setup","url":"/Simple-Roblox-Framework/docs/setup#create-a-project-using-this-template","content":" Go to the github page of this repository.Click Use this template &gt; Create a new repository.Replace the word Simple-Roblox-Framework in default.project.json and package.json with your project name.  ","version":"Next","tagName":"h3"},{"title":"Install Dependencies​","type":1,"pageTitle":"setup","url":"/Simple-Roblox-Framework/docs/setup#install-dependencies","content":" Install pnpm version &gt;= 10.x.Install the latest version of foreman.Run pnpm i, and ignore the error ERR_PNPM_IGNORED_BUILDS if encountered.Run foreman install.  ","version":"Next","tagName":"h3"},{"title":"Configure Rojo Auto-startup (Optional)​","type":1,"pageTitle":"setup","url":"/Simple-Roblox-Framework/docs/setup#configure-rojo-auto-startup-optional","content":" Open the workspace in vscode.Use Ctrl+Shift+P to open the command palette.Select Tasks: Manage Automatic Tasks &gt; Allow Automatic Tasks. ","version":"Next","tagName":"h3"},{"title":"usage","type":0,"sectionRef":"#","url":"/Simple-Roblox-Framework/docs/usage","content":"","keywords":"","version":"Next"},{"title":"API Types​","type":1,"pageTitle":"usage","url":"/Simple-Roblox-Framework/docs/usage#api-types","content":" ","version":"Next","tagName":"h3"},{"title":"Adding an App​","type":1,"pageTitle":"usage","url":"/Simple-Roblox-Framework/docs/usage#adding-an-app","content":" Navigate to src/{Server|Client}/Apps.Create a new folder with the name of your app.Create an init.luau file in the folder.Update the file to return an AppManifest, which looks like:  { Name: string, -- does not have to be unique Run: (Context: AppContext) -&gt; (), -- non-yielding OnCrash: ((Context: ErrorContext) -&gt; ())?, Priority: number?, -- larger = run earlier Disabled: boolean?, }  ","version":"Next","tagName":"h3"}],"options":{"id":"default"}}